# Copy to config.env and edit. config.env is git-ignored.
AZ_SUBSCRIPTION=""                 # subscription ID (empty = current az default)
AZ_RESOURCE_GROUP="nixos-images"   # must already exist
AZ_LOCATION="westeurope"

GALLERY_NAME="nixgallery"
IMAGE_DEFINITION="nixos-arm64"
IMAGE_PUBLISHER="example"          # gallery image identifier, any string
IMAGE_OFFER="nixos"
IMAGE_SKU="unstable-arm64"

# Prefix for temporary build/test resources; cleanup removes everything tagged with it.
TEMP_PREFIX="nixos-img"
BUILDER_SIZE="Standard_D4pls_v5"   # remote builds only
TEST_SIZE="Standard_D2pls_v5"
TEST_OS_DISK_GB=32

ADMIN_USER="azureuser"
SSH_PUBLIC_KEY="$HOME/.ssh/id_ed25519.pub"
